NODE_ENV=qa
BASE_UI_URL=https://automationexercise.com
BASE_API_URL=https://automationexercise.com
AUTH_URL=https://example-auth.local/token
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
API_HEALTH_ENDPOINT=/health
MONITORING_STATUS_ENDPOINT=/status
APP_INSIGHTS_APP_ID=your-app-insights-id
